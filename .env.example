# Public hostname handled by Caddy. Use localhost for local testing.
APP_HOST=localhost

# PostgreSQL container settings.
POSTGRES_DB=management_log
POSTGRES_USER=management
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Used when running the API outside Docker Compose.
DATABASE_URL=postgres://management:replace-with-a-strong-local-password@localhost:5432/management_log
PORT=4000
HOST=0.0.0.0
